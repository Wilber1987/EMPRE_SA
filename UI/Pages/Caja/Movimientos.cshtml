@page
@using API.Controllers
@using APPCORE.Security
@{
    if (!SecurityController.Auth(HttpContext.Session.GetString("sessionKey")))
    {
        Response.Redirect("../Security/login");
        return;
    }
    @if (!SecurityController.HavePermission(HttpContext.Session.GetString("sessionKey"),
    Permissions.GESTION_VENTAS, Permissions.GESTION_RECIBOS))//todo
    {
        Response.Redirect("../Security/login");
        return;
    }
}
<script type="module">
    import { WCajasView } from "/Caja/WCajasView.js";



    window.onload = () => {
        // Crear instancia
        const processor = new WCajasView();

        // Añadir al DOM
        MainBody.appendChild(processor);
    }

    
</script>
<div id="MainBody" class="app-container"></div>
